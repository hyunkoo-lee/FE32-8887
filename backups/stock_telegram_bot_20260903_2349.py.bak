def ensure_korean_font():
    """
    [폰트 준비 함수]
    ReportLab PDF 생성 및 Matplotlib 차트 시각화 시 한글 깨짐 방지를 위하여
    Google Fonts(NanumGothic)에서 한글 TTF 폰트(Regular, Bold)를 임시 디렉토리에 다운로드하고
    ReportLab 및 Matplotlib 레지스트리에 등록합니다.
    
    Returns:
        tuple: (font_name, bold_font_name) - 등록된 폰트 이름 식별자
    """
    font_name = "NanumGothic"
    bold_font_name = "NanumGothicBold"
    
    font_path = os.path.join(tempfile.gettempdir(), "NanumGothic.ttf")
    bold_font_path = os.path.join(tempfile.gettempdir(), "NanumGothicBold.ttf")
    
    if not os.path.exists(font_path):
        try:
            res = requests.get("https://github.com/google/fonts/raw/main/ofl/nanumgothic/NanumGothic-Regular.ttf", timeout=10)
            if res.status_code == 200:
                with open(font_path, "wb") as f:
                    f.write(res.content)
        except Exception as e:
            print(f"⚠️ 폰트 다운로드 실패: {e}")

    if not os.path.exists(bold_font_path):
        try:
            res = requests.get("https://github.com/google/fonts/raw/main/ofl/nanumgothic/NanumGothic-Bold.ttf", timeout=10)
            if res.status_code == 200:
                with open(bold_font_path, "wb") as f:
                    f.write(res.content)
        except Exception as e:
            print(f"⚠️ 볼드 폰트 다운로드 실패: {e}")

    try:
        pdfmetrics.registerFont(TTFont(font_name, font_path))
        pdfmetrics.registerFont(TTFont(bold_font_name, bold_font_path))
    except Exception as e:
        print(f"⚠️ 폰트 등록 실패: {e}")

    return font_name, bold_font_name

def extract_sheet_id(url_or_id):
    """
    [구글 시트 ID 추출 함수]
    사용자가 입력한 전체 구글 시트 URL(https://docs.google.com/spreadsheets/d/.../edit) 또는
    순수 시트 ID 문자열에서 구글 시트 식별자(Spreadsheet ID)만 추출하여 반환합니다.
    
    Args:
        url_or_id (str): 구글 시트 URL 또는 시트 ID
        
    Returns:
        str or None: 추출된 구글 시트 ID
    """
    if not url_or_id:
        return None
    if "/d/" in url_or_id:
        parts = url_or_id.split("/d/")[1]
        sheet_id = parts.split("/")[0]
        return sheet_id
    return url_or_id.strip()

def normalize_ticker_symbol(symbol):
    """
    [야후 파이낸스 티커 정규화 함수]
    입력된 종목코드를 야후 파이낸스(yfinance) 조회가 가능한 형태로 정규화합니다.
    - 국내 6자리 종목코드(알파벳+숫자 혼용 신종목코드 포함, 예: 441800, 0167B0, 0219E0 등) 뒤에 '.KS' 접미사 부착
    - 기존 '.KR' 접미사를 '.KS'로 변환 및 영문 대문자 정돈
    
    Args:
        symbol (str): 입력 종목코드
        
    Returns:
        str: 정규화된 야후 파이낸스 티커 symbol (예: '441800.KS', '0167B0.KS', 'SCHD')
    """
    symbol = symbol.strip().upper()
    if symbol.endswith(".KR"):
        symbol = symbol[:-3] + ".KS"
    elif len(symbol) == 6 and symbol.isalnum() and not symbol.isalpha():
        # 6자리 알파벳/숫자 혼용 국내 종목코드 (0167B0, 0219E0 등)
        if not (symbol.endswith(".KS") or symbol.endswith(".KQ")):
            symbol = symbol + ".KS"
    return symbol

def normalize_display_symbol(symbol):
    """
    [표시용 종목코드 정돈 함수]
    텔레그램 메시지 및 PDF 요약표에 깔끔하게 출력하기 위해
    야후 파이낸스용 접미사('.KS', '.KQ')를 제거한 6자리 순수 종목코드를 반환합니다.
    
    Args:
        symbol (str): 야후 파이낸스 티커 symbol
        
    Returns:
        str: 화면 표시용 종목코드 (예: '441800.KS' -> '441800')
    """
    if symbol.endswith(".KS") or symbol.endswith(".KQ"):
        return symbol[:-3]
    return symbol

def fetch_naver_stock_name(symbol_or_code):
    """
    [네이버 증권 한글 종목명 조회 함수]
    네이버 증권 API(m.stock.naver.com & api.stock.naver.com)를 호출하여
    국내 주식/ETF(신종목코드 포함) 및 해외 주식의 공식 한글 종목명을 자동으로 가져옵니다.
    
    Args:
        symbol_or_code (str): 종목코드 또는 티커
        
    Returns:
        str or None: 네이버 증권에서 조회된 공식 한글 종목명 (조회 실패 시 None)
    """
    headers = {'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64)'}
    clean_code = symbol_or_code.replace('.KS', '').replace('.KQ', '').strip()
    
    # 1. 국내 주식/ETF (6자리 숫자 및 알파벳 혼용 신종목코드 포함)
    if len(clean_code) == 6 and clean_code.isalnum():
        try:
            url = f"https://m.stock.naver.com/api/stock/{clean_code}/basic"
            res = requests.get(url, headers=headers, timeout=5)
            if res.status_code == 200:
                name = res.json().get('stockName')
                if name:
                    return name
        except Exception:
            pass

    # 2. 해외 주식 (api.stock.naver.com)
    for suffix in ['.O', '.N', '.A', '']:
        try:
            url = f"https://api.stock.naver.com/stock/{clean_code}{suffix}/basic"
            res = requests.get(url, headers=headers, timeout=5)
            if res.status_code == 200:
                name = res.json().get('stockName')
                if name:
                    return name
        except Exception:
            pass

    return None

def fetch_tickers_from_google_sheet(sheet_url_or_id):
    """
    [구글 시트 종목 목록 파싱 함수]
    연동된 구글 시트를 CSV 형식으로 읽어와 A열(종목코드), B열(종목명), C열(매수전략/메모)을 파싱합니다.
    네이버 증권 API를 통해 최신 공식 한글 종목명을 우선 반영합니다.
    
    Args:
        sheet_url_or_id (str): 구글 시트 URL 또는 ID
        
    Returns:
        list[dict]: 파싱된 종목 정보 사전 리스트
    """
    sheet_id = extract_sheet_id(sheet_url_or_id)
    if not sheet_id:
        return []

    csv_url = f"https://docs.google.com/spreadsheets/d/{sheet_id}/export?format=csv"
    try:
        res = requests.get(csv_url, timeout=10)
        if res.status_code != 200:
            print(f"⚠️ 구글 시트 불러오기 실패 (HTTP {res.status_code})")
            return []

        csv_text = res.content.decode('utf-8')
        reader = csv.reader(io.StringIO(csv_text))
        
        tickers = []
        for row in reader:
            if not row or len(row) == 0:
                continue
            raw_symbol = row[0].strip()
            
            if raw_symbol.upper() in ["SYMBOL", "TICKER", "티커", "종목코드", "종목"]:
                continue
            
            if not raw_symbol:
                continue

            symbol = normalize_ticker_symbol(raw_symbol)
            sheet_name = row[1].strip() if len(row) > 1 and row[1].strip() else None
            strategy = row[2].strip() if len(row) > 2 and row[2].strip() else "지정된 메모 없음"

            naver_name = fetch_naver_stock_name(symbol)
            final_name = naver_name or sheet_name or symbol

            tickers.append({
                "symbol": symbol,
                "raw_symbol": raw_symbol,
                "display_symbol": normalize_display_symbol(symbol),
                "name": final_name,
                "strategy_summary": strategy
            })

        print(f"📊 구글 시트에서 총 {len(tickers)}개 종목을 가져왔습니다.")
        return tickers
    except Exception as e:
        print(f"⚠️ 구글 시트 읽기 중 오류 발생: {e}")
        return []

def get_stock_data(symbol):
    """
    [주가 시세 및 뉴스 수집 함수]
    yfinance 라이브러리를 이용해 해당 종목의 시가(Open), 고가(High), 저가(Low), 종가(Close),
    전일 대비 등락률(%), 통화 단위 및 관련 최근 뉴스 2건을 수집합니다.
    
    Args:
        symbol (str): 야후 파이낸스 티커 symbol
        
    Returns:
        dict or None: 주가 데이터 사전 객체 (조회 실패 시 None)
    """
    try:
        ticker = yf.Ticker(symbol)
        df = ticker.history(period="5d")
        
        if df.empty and symbol.endswith(".KS"):
            kq_symbol = symbol[:-3] + ".KQ"
            ticker = yf.Ticker(kq_symbol)
            df = ticker.history(period="5d")

        if df.empty:
            return None
        
        latest_row = df.iloc[-1]
        date_str = latest_row.name.strftime('%Y-%m-%d')
        
        open_price = float(latest_row['Open'])
        high_price = float(latest_row['High'])
        low_price = float(latest_row['Low'])
        close_price = float(latest_row['Close'])
        volume = int(latest_row['Volume'])
        
        prev_close = float(df.iloc[-2]['Close']) if len(df) > 1 else close_price
        change_pct = ((close_price - prev_close) / prev_close) * 100

        news_items = []
        try:
            raw_news = ticker.news
            if raw_news:
                for item in raw_news[:2]:
                    title = item.get("title") or item.get("content", {}).get("title")
                    if title:
                        news_items.append(title)
        except Exception:
            pass

        return {
            "date": date_str,
            "open": open_price,
            "high": high_price,
            "low": low_price,
            "close": close_price,
            "change_pct": change_pct,
            "volume": volume,
            "currency": "₩" if (symbol.endswith(".KS") or symbol.endswith(".KQ")) else "$",
            "news": news_items
        }
    except Exception as e:
        print(f"⚠️ {symbol} 데이터 조회 실패: {e}")
        return None

def generate_open_close_full_page_chart(stock_results, chart_img_path):
    """
    [PDF 2페이지 풀페이지 도식화 차트 생성 함수]
    Matplotlib을 사용하여 A4 가로 한 페이지를 꽉 채우는 대형 가로 바 차트를 작성합니다.
    - 기준점(0%)을 화면 정확히 중앙에 배치
    - 기본 표시 범위: -10% ~ +10% (10% 초과 종목 존재 시 정수 단위 대칭 확장)
    - 하단 수치 표기: 0.5% 단위 간격 (np.arange(-limit, limit + 0.001, 0.5))
    - 막대 내부/외부에 '(등락률%) 종가: ₩XX,XXX' 형태로 시각화하여 고화질 이미지로 저장합니다.
    
    Args:
        stock_results (list[dict]): 종목별 시세 데이터 리스트
        chart_img_path (str): 저장할 이미지 파일 경로
        
    Returns:
        str or None: 생성된 차트 이미지 파일 경로
    """
    font_path = os.path.join(tempfile.gettempdir(), "NanumGothic.ttf")
    if os.path.exists(font_path):
        fm.fontManager.addfont(font_path)
        plt.rc('font', family='NanumGothic')
    plt.rcParams['axes.unicode_minus'] = False

    valid_items = [r for r in stock_results if r.get('data')]
    if not valid_items:
        return None

    names = [f"{r['name']} ({r.get('display_symbol', r['symbol'])})" for r in valid_items]
    pcts = [r['data']['change_pct'] for r in valid_items]
    colors_list = ['#DC2626' if p > 0 else ('#2563EB' if p < 0 else '#64748B') for p in pcts]

    # 풀페이지 대형 바 차트 생성 (Landscape A4 너비/높이에 맞춤)
    fig, ax = plt.subplots(figsize=(16, max(9.0, len(valid_items) * 0.5)))
    bars = ax.barh(names, pcts, color=colors_list, height=0.62, edgecolor='#1E293B', linewidth=0.8)

    # 1. 기준점 0을 화면 중앙에 대칭 배치 (기본 범위: -10% ~ +10%)
    max_abs = max([abs(p) for p in pcts] + [10.0])
    limit = max(10.0, math.ceil(max_abs))
    ax.set_xlim(-limit, limit)

    # 2. 하단 수치 표기 (0.5% 단위)
    ticks = np.arange(-limit, limit + 0.001, 0.5)
    tick_labels = [f"{x:.0f}%" if x.is_integer() else f"{x:.1f}%" for x in ticks]
    ax.set_xticks(ticks)
    ax.set_xticklabels(tick_labels, fontsize=7.5, rotation=45)

    # 기준선 (0%) 중앙 강조선
    ax.axvline(0, color='#1E293B', linewidth=2.0, linestyle='-')
    ax.set_xlabel('종목별 등락률 (%) [기준점: 0% 중앙 배치, 0.5% 단위 표기]', fontsize=13, fontweight='bold', labelpad=14)
    ax.set_title('종목별 수익률 및 종가 변동 도식화 그래프 (기본 -10% ~ +10% 대칭)', fontsize=18, fontweight='bold', pad=22)
    ax.grid(axis='x', linestyle=':', alpha=0.5, color='#CBD5E1')
    ax.tick_params(axis='y', labelsize=11)

    # 요청 사항: 그래프에는 %율과 종가만 (순서: %, 종가 순) 표기
    for bar, item in zip(bars, valid_items):
        width = bar.get_width()
        data = item['data']
        curr = data.get('currency', '$')
        cl = data['close']
        
        if curr == '₩':
            close_str = f"₩{cl:,.0f}"
        else:
            close_str = f"${cl:.2f}"

        price_text = f" ({width:+.2f}%) 종가: {close_str} "

        # 막대 너비에 따라 내부(Inside Bar) 또는 외부 텍스트 배치
        threshold = limit * 0.08  # 상대적 임계값 (전체 범위의 8%)
        if width >= 0:
            if width >= threshold:
                ax.text(
                    width * 0.96, 
                    bar.get_y() + bar.get_height()/2, 
                    price_text, 
                    va='center', 
                    ha='right', 
                    fontsize=10, 
                    fontweight='bold', 
                    color='#FFFFFF'
                )
            else:
                ax.text(
                    width + (limit * 0.01), 
                    bar.get_y() + bar.get_height()/2, 
                    price_text, 
                    va='center', 
                    ha='left', 
                    fontsize=10, 
                    fontweight='bold', 
                    color='#0F172A',
                    bbox=dict(boxstyle="round,pad=0.2", fc="#F8FAFC", ec="#CBD5E1", lw=0.6)
                )
        else:
            if abs(width) >= threshold:
                ax.text(
                    width * 0.96, 
                    bar.get_y() + bar.get_height()/2, 
                    price_text, 
                    va='center', 
                    ha='left', 
                    fontsize=10, 
                    fontweight='bold', 
                    color='#FFFFFF'
                )
            else:
                ax.text(
                    width - (limit * 0.01), 
                    bar.get_y() + bar.get_height()/2, 
                    price_text, 
                    va='center', 
                    ha='right', 
                    fontsize=10, 
                    fontweight='bold', 
                    color='#0F172A',
                    bbox=dict(boxstyle="round,pad=0.2", fc="#F8FAFC", ec="#CBD5E1", lw=0.6)
                )

    plt.tight_layout()
    plt.savefig(chart_img_path, dpi=300, bbox_inches='tight')
    plt.close()
    return chart_img_path

def create_stock_pdf_report(stock_results, latest_date, pdf_filepath):
    """
    [ReportLab PDF 리포트 문서 빌드 함수]
    ReportLab 라이브러리를 사용하여 2페이지 구조의 가로형(Landscape A4) PDF 문서 파일(.pdf)을 생성합니다.
    - 1페이지: 종목코드, 종목명, 시가, 종가, 수익률, 당일 변동 범위, 메모가 담긴 종합 시세 표
    - 2페이지: 등락률(%)과 종가가 표기된 대형 풀페이지 시각화 차트 그래프
    
    Args:
        stock_results (list[dict]): 종목별 시세 데이터 리스트
        latest_date (str): 시세 기준 일자
        pdf_filepath (str): 생성될 PDF 파일 경로
    """
    font_name, bold_font_name = ensure_korean_font()
    
    # A4 가로 페이지 (너비 842pt, 높이 595pt)
    doc = SimpleDocTemplate(
        pdf_filepath,
        pagesize=landscape(A4),
        leftMargin=25,
        rightMargin=25,
        topMargin=25,
        bottomMargin=25
    )
    
    styles = getSampleStyleSheet()
    
    title_style = ParagraphStyle(
        'DocTitle',
        parent=styles['Normal'],
        fontName=bold_font_name,
        fontSize=18,
        leading=22,
        textColor=colors.HexColor('#1E293B'),
        spaceAfter=15
    )
    
    sub_style = ParagraphStyle(
        'DocSubTitle',
        parent=styles['Normal'],
        fontName=font_name,
        fontSize=10,
        leading=14,
        textColor=colors.HexColor('#64748B'),
        spaceAfter=12
    )

    hdr_style = ParagraphStyle(
        'HdrCell',
        parent=styles['Normal'],
        fontName=bold_font_name,
        fontSize=10,
        leading=12,
        textColor=colors.white,
        alignment=1
    )

    cell_left = ParagraphStyle(
        'CellLeft',
        parent=styles['Normal'],
        fontName=font_name,
        fontSize=9,
        leading=12,
        textColor=colors.HexColor('#1E293B')
    )

    cell_center = ParagraphStyle(
        'CellCenter',
        parent=styles['Normal'],
        fontName=font_name,
        fontSize=9,
        leading=12,
        alignment=1,
        textColor=colors.HexColor('#1E293B')
    )

    cell_right = ParagraphStyle(
        'CellRight',
        parent=styles['Normal'],
        fontName=font_name,
        fontSize=9,
        leading=12,
        alignment=2,
        textColor=colors.HexColor('#1E293B')
    )

    cell_bold_plus = ParagraphStyle(
        'CellPlus',
        parent=styles['Normal'],
        fontName=bold_font_name,
        fontSize=9,
        leading=12,
        alignment=2,
        textColor=colors.HexColor('#DC2626') # 빨간색
    )

    cell_bold_minus = ParagraphStyle(
        'CellMinus',
        parent=styles['Normal'],
        fontName=bold_font_name,
        fontSize=9,
        leading=12,
        alignment=2,
        textColor=colors.HexColor('#2563EB') # 파란색
    )

    # 순서: 종목코드, 종목명, 시가, 종가, 수익률, 당일 변동 범위, 메모 및 보유전략
    table_data = [
        [
            Paragraph('종목코드', hdr_style),
            Paragraph('종목명(한글)', hdr_style),
            Paragraph('시가', hdr_style),
            Paragraph('종가', hdr_style),
            Paragraph('수익률', hdr_style),
            Paragraph('당일 변동 범위', hdr_style),
            Paragraph('메모 및 보유 전략', hdr_style)
        ]
    ]

    for item in stock_results:
        disp_symbol = item.get('display_symbol', item['symbol'])
        name = item['name']
        data = item['data']
        strategy = item['strategy_summary']

        if data:
            curr = data.get("currency", "$")
            pct = data['change_pct']
            close_price = data['close']
            open_price = data['open']

            if curr == "₩":
                open_str = f"₩{data['open']:,.0f}"
                close_str = f"₩{data['close']:,.0f}"
                range_str = f"₩{data['low']:,.0f} ~ ₩{data['high']:,.0f}"
            else:
                open_str = f"${data['open']:.2f}"
                close_str = f"${data['close']:.2f}"
                range_str = f"${data['low']:.2f} ~ ${data['high']:.2f}"

            # 종가 색상 규칙: 종가 > 시가 (빨간색), 종가 < 시가 (파란색), 종가 = 시가 (검은색)
            if close_price > open_price:
                close_paragraph = Paragraph(close_str, cell_bold_plus)
            elif close_price < open_price:
                close_paragraph = Paragraph(close_str, cell_bold_minus)
            else:
                close_paragraph = Paragraph(close_str, cell_right)

            # 수익률 색상 규칙: > 0 (빨간색), < 0 (파란색), = 0 (검은색)
            if pct > 0:
                pct_str = f"+{pct:.2f}%"
                pct_paragraph = Paragraph(pct_str, cell_bold_plus)
            elif pct < 0:
                pct_str = f"{pct:.2f}%"
                pct_paragraph = Paragraph(pct_str, cell_bold_minus)
            else:
                pct_str = f"{pct:.2f}%"
                pct_paragraph = Paragraph(pct_str, cell_center)
        else:
            open_str = "-"
            close_str = "조회실패"
            range_str = "-"
            close_paragraph = Paragraph("조회실패", cell_center)
            pct_paragraph = Paragraph("-", cell_center)

        table_data.append([
            Paragraph(disp_symbol, cell_center),
            Paragraph(name, cell_left),
            Paragraph(open_str, cell_right),
            close_paragraph,
            pct_paragraph,
            Paragraph(range_str, cell_center),
            Paragraph(strategy, cell_left)
        ])

    # 7개 컬럼 총 너비 = 792pt (Landscape A4 너비 842 - 여백 50)
    col_widths = [70, 170, 75, 75, 75, 125, 202]
    t = Table(table_data, colWidths=col_widths, repeatRows=1)
    
    t.setStyle(TableStyle([
        ('BACKGROUND', (0,0), (-1,0), colors.HexColor('#1E3A8A')),
        ('ALIGN', (0,0), (-1,-1), 'CENTER'),
        ('VALIGN', (0,0), (-1,-1), 'MIDDLE'),
        ('GRID', (0,0), (-1,-1), 0.5, colors.HexColor('#CBD5E1')),
        ('ROWBACKGROUNDS', (0,1), (-1,-1), [colors.white, colors.HexColor('#F8FAFC')]),
        ('TOPPADDING', (0,0), (-1,-1), 7),
        ('BOTTOMPADDING', (0,0), (-1,-1), 7),
    ]))

    # Page 1: 종합 시세 요약 표
    elements = [
        Paragraph(f"📊 [주식 시가·종가 종합 시세 리포트]", title_style),
        Paragraph(f"📅 <b>기준일자:</b> {latest_date} | <b>생성시각:</b> {datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S')}", sub_style),
        Spacer(1, 8),
        t
    ]

    # Page 2: %, 종가 순서 표기 풀페이지 도식화 차트
    chart_filepath = os.path.join(tempfile.gettempdir(), "stock_full_page_chart.png")
    if generate_open_close_full_page_chart(stock_results, chart_filepath) and os.path.exists(chart_filepath):
        elements.append(PageBreak()) # 2페이지 전용 배치
        elements.append(Paragraph("<b>📈 [종목별 수익률 및 종가 변동 도식화 그래프]</b>", title_style))
        elements.append(Spacer(1, 8))
        elements.append(Image(chart_filepath, width=790, height=485))

    doc.build(elements)
    print(f"📄 PDF 리포트 생성 완료: {pdf_filepath}")

def format_telegram_message(stock_results):
    """
    [텔레그램 브리핑 메시지 포맷팅 함수]
    텔레그램 채팅창에 발송할 상세 카드 형태의 HTML 포맷 텍스트 메시지를 생성합니다.
    수익률에 따라 빨간색 상승 삼각형(🔺), 파란색 동그라미(🔵), 노란색 동그라미(🟡) 아이콘을 적용합니다.
    
    Args:
        stock_results (list[dict]): 종목별 시세 데이터 리스트
        
    Returns:
        tuple: (HTML 메시지 문자열, 기준일자 문자열)
    """
    if not stock_results:
        return "데이터를 불러오는 데 실패했습니다."

    latest_date = None
    for r in stock_results:
        if r.get('data'):
            latest_date = r['data']['date']
            break
    if not latest_date:
        latest_date = datetime.date.today().strftime('%Y-%m-%d')
    
    msg = f"<b>📊 [주식 시가/종가 브리핑]</b>\n"
    msg += f"📅 기준일자: <code>{latest_date}</code>\n"
    msg += f"📎 <i>전체 시세 표 및 풀페이지 시가/종가 도식화 그래프는 아래 첨부된 PDF 문서로 확인하실 수 있습니다.</i>\n\n"

    msg += "<b>📋 종목별 상세 현황 및 메모</b>\n\n"

    for item in stock_results:
        symbol = item['symbol']
        disp_symbol = item.get('display_symbol', symbol)
        name = item['name']
        data = item['data']
        strategy = item['strategy_summary']

        msg += f"▪️ <b>{name} ({disp_symbol})</b>\n"
        if data:
            curr = data.get("currency", "$")
            pct = data['change_pct']

            # 아이콘 규칙: 
            #   플러스(+) = 빨강 삼각형 (🔺)
            #   마이너스(-) = 파랑 동그라미 (🔵)
            #   보합(0%) = 노랑 동그라미 (🟡)
            if pct > 0:
                icon = "🔺"
            elif pct < 0:
                icon = "🔵"
            else:
                icon = "🟡"

            if curr == "₩":
                msg += f"  • <b>종가:</b> ₩{data['close']:,.0f} ({icon} <b>{pct:+.2f}%</b>)\n"
                msg += f"  • <b>시가:</b> ₩{data['open']:,.0f} | <b>범위:</b> ₩{data['low']:,.0f} ~ ₩{data['high']:,.0f}\n"
            else:
                msg += f"  • <b>종가:</b> ${data['close']:.2f} ({icon} <b>{pct:+.2f}%</b>)\n"
                msg += f"  • <b>시가:</b> ${data['open']:.2f} | <b>범위:</b> ${data['low']:.2f} ~ ${data['high']:.2f}\n"
        else:
            msg += f"  • 주가 데이터를 조회할 수 없습니다.\n"

        if strategy and strategy != "지정된 메모 없음":
            msg += f"  💡 <b>메모:</b> {strategy}\n"

        if data and data.get('news'):
            msg += "  📰 <b>최근 뉴스:</b>\n"
            for news_title in data['news']:
                msg += f"    - {news_title}\n"

        msg += "\n"

    msg += "⚠️ <i>본 리포트는 자동 생성되었으며 투자 참고용입니다.</i>"
    return msg, latest_date

def send_telegram_message(bot_token, chat_id, message):
    """
    [텔레그램 텍스트 메시지 발송 API 함수]
    Telegram Bot API(sendMessage)를 호출하여 작성된 브리핑 HTML 메시지를 텔레그램으로 발송합니다.
    
    Args:
        bot_token (str): 텔레그램 봇 토큰
        chat_id (str): 대상 텔레그램 채팅방 ID
        message (str): 발송할 HTML 메시지 텍스트
        
    Returns:
        dict: 텔레그램 API 응답 JSON 객체
    """
    url = f"https://api.telegram.org/bot{bot_token}/sendMessage"
    payload = {
        "chat_id": chat_id,
        "text": message,
        "parse_mode": "HTML",
        "disable_web_page_preview": True
    }
    response = requests.post(url, data=payload)
    return response.json()

def send_telegram_document(bot_token, chat_id, file_path, filename, caption=None):
    """
    [텔레그램 문서 파일(PDF) 첨부 발송 API 함수]
    Telegram Bot API(sendDocument)를 호출하여 생성된 PDF 리포트 파일(.pdf)을 텔레그램으로 발송합니다.
    
    Args:
        bot_token (str): 텔레그램 봇 토큰
        chat_id (str): 대상 텔레그램 채팅방 ID
        file_path (str): 발송할 PDF 파일 경로
        filename (str): 첨부 파일 표시 이름
        caption (str, optional): 캡션 텍스트
        
    Returns:
        dict: 텔레그램 API 응답 JSON 객체
    """
    url = f"https://api.telegram.org/bot{bot_token}/sendDocument"
    data = {"chat_id": chat_id, "parse_mode": "HTML"}
    if caption:
        data["caption"] = caption
    try:
        with open(file_path, "rb") as f:
            files = {"document": (filename, f, "application/pdf")}
            res = requests.post(url, data=data, files=files)
            return res.json()
    except Exception as e:
        print(f"⚠️ PDF 파일 전송 중 오류: {e}")
        return {"ok": False}

def main():
    """
    [프로그램 메인 실행 파이프라인 함수]
    전체 주식 브리핑 자동화 파이프라인의 실행 흐름을 제어합니다:
    1. 환경 변수 및 설정 검증
    2. 구글 시트 / 기본 종목 파싱 및 네이버 증권 종목명 연동
    3. 야후 파이낸스 주가 시세 및 관련 뉴스 수집
    4. HTML 브리핑 메시지 포맷팅 및 PDF 문서 파일(1페이지 표, 2페이지 차트) 생성
    5. 텔레그램 전송 (메시지 먼저 발송 ➡️ PDF 파일 마지막 발송)
    6. 임시 파일 Cleanup 처리
    """
    is_dry_run = "--dry-run" in sys.argv or "--test" in sys.argv

    if not is_dry_run and (not TELEGRAM_BOT_TOKEN or not TELEGRAM_CHAT_ID):
        print("❌ 오류: TELEGRAM_BOT_TOKEN 또는 TELEGRAM_CHAT_ID 값이 설정되지 않았습니다.")
        sys.exit(1)

    target_tickers = []
    if GOOGLE_SHEET_URL:
        print(f"📖 구글 시트에서 종목 목록 조회 중... ({GOOGLE_SHEET_URL})")
        target_tickers = fetch_tickers_from_google_sheet(GOOGLE_SHEET_URL)
    
    if not target_tickers:
        print("📌 기본 설정된 종목 목록을 사용합니다.")
        for item in DEFAULT_TARGET_TICKERS:
            naver_name = fetch_naver_stock_name(item['symbol'])
            final_name = naver_name or item['name']
            target_tickers.append({
                "symbol": item['symbol'],
                "display_symbol": normalize_display_symbol(item['symbol']),
                "name": final_name,
                "strategy_summary": item['strategy_summary']
            })

    print(f"🔍 총 {len(target_tickers)}개 종목 데이터 조회 중...")
    results = []
    for item in target_tickers:
        data = get_stock_data(item['symbol'])
        results.append({
            "symbol": item['symbol'],
            "display_symbol": item.get('display_symbol', item['symbol']),
            "name": item['name'],
            "strategy_summary": item['strategy_summary'],
            "data": data
        })

    report_msg, latest_date = format_telegram_message(results)

    # 1. PDF 리포트 파일 생성
    pdf_filename = f"주식_시세_요약표_{latest_date}.pdf"
    pdf_filepath = os.path.join(tempfile.gettempdir(), pdf_filename)
    create_stock_pdf_report(results, latest_date, pdf_filepath)

    if is_dry_run:
        print("🧪 Dry-run 모드입니다. 텔레그램 메시지 및 PDF를 실제로 전송하지 않았습니다.")
        return

    print("🚀 텔레그램 전송 순서: [1] 메인 브리핑 메시지 ➡️ [2] PDF 문서 파일")

    # 1. 메인 브리핑 메시지 먼저 전송 (FIRST)
    msg_res = send_telegram_message(TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID, report_msg)
    print(f"  • 메시지 전송 결과: {'성공' if msg_res.get('ok') else '실패'}")

    # 2. PDF 요약 문서 파일 마지막으로 전송 (LAST)
    doc_res = send_telegram_document(
        TELEGRAM_BOT_TOKEN, 
        TELEGRAM_CHAT_ID, 
        pdf_filepath, 
        pdf_filename, 
        caption=f"<b>📄 주식 시세 요약 표 및 등락률/종가 도식화 PDF 문서 ({latest_date})</b>"
    )
    print(f"  • PDF 파일 전송 결과: {'성공' if doc_res.get('ok') else '실패'}")

    if msg_res.get("ok") and doc_res.get("ok"):
        print("✅ 텔레그램 메세지 및 PDF 전송 완벽 성공!")
    else:
        print(f"⚠️ 전송 결과: 메시지={msg_res.get('ok')}, PDF={doc_res.get('ok')}")

    # 임시 PDF 파일 삭제
    if os.path.exists(pdf_filepath):
        os.remove(pdf_filepath)

if __name__ == "__main__":
    main()
