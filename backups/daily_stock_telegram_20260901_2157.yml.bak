name: Daily Stock Telegram Report

on:
  schedule:
    # 매일(월~일) 한국시간 오후 4시 05분 (UTC 07:05) 1회 실행
    # (정각 00분에는 GitHub 서버 부하 집중으로 누락될 수 있어 05분에 설정)
    - cron: '5 7 * * *'
  workflow_dispatch: # 수동 실행 버튼 추가

jobs:
  send-report:
    runs-on: ubuntu-latest
    steps:
      - name: Check out repository
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.12'

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install -r requirements.txt

      - name: Run Stock Telegram Bot
        env:
          TELEGRAM_BOT_TOKEN: ${{ secrets.TELEGRAM_BOT_TOKEN }}
          TELEGRAM_CHAT_ID: ${{ secrets.TELEGRAM_CHAT_ID }}
          GOOGLE_SHEET_URL: ${{ secrets.GOOGLE_SHEET_URL }}
        run: python stock_telegram_bot.py
